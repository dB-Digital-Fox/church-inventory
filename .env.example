# Copy to .env and adjust. Never commit the real .env.

# Name shown in the app and in calendar feeds
ORG_NAME=Farnosť – inventár
# Public address (used in QR codes, emails and calendar links)
BASE_URL=https://inventar.example.sk
TZ=Europe/Bratislava
DEFAULT_LANGUAGE=sk

# Set to 1 when the app is reached over HTTPS (Cloudflare Tunnel, Tailscale HTTPS)
SECURE_COOKIES=1

# Where backups go on the host (e.g. a USB drive mounted at /mnt/usb)
BACKUP_PATH=./backups
BACKUP_HOUR=2
BACKUP_KEEP=14
# Hour when reservation reminders and the auditor fingerprint are sent
REMINDER_HOUR=18

# --- Email (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=1

# --- WhatsApp Cloud API (optional, see docs/whatsapp.md) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=sk

# --- Cloudflare Tunnel (optional, see docs/cloudflare-tunnel.md) ---
TUNNEL_TOKEN=
